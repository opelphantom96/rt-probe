# Python bytecode
__pycache__/
*.pyc

# Compiled probe binaries (regenerated by `make` in probes/)
probes/bin/

# CLI run outputs (reports, histograms, serial logs, charts)
out/

# mkqnximage / QEMU build artefacts (created outside the repo by default,
# but never commit them if a run puts them here)
output/
*.img
*.iso
*.qcow2
ifs.bin

# Local toolchains / environments (documented prerequisites, not repo content)
.venv/
venv/

# QNX licence and any credentials — NEVER commit these.
# The licence lives only at ~/.qnx/license/licenses; check it with `ls -l`.
*.pem
*.key
licenses
license/

# Editor / OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/
